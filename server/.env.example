# ==============================================================================
# ONECOOLIE Production Environment Configuration Template
# Phase 6: Production Hardening & Security Readiness
# NOTE: Never commit production values or private keys into source control!
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production

# Server Port
PORT=5000

# Client Origins & CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes)
CLIENT_URL=https://onecoolie.in
ALLOWED_ORIGINS=https://onecoolie.in,https://admin.onecoolie.in

# Supabase Database Infrastructure
SUPABASE_URL=https://your-project.supabase.co
# Anonymous / publishable key
SUPABASE_KEY=your-supabase-publishable-key
# Service role secret key (REQUIRED for backend transactions and ledger invariants)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Session & JWT Authentication
# Must be a cryptographically secure random string (minimum 32 characters in production)
JWT_SECRET=your-secure-random-32-byte-hex-string

# Admin TOTP Multi-Factor Authentication Encryption Key (REQUIRED in production)
# Must be a 32-byte random key formatted as a 64-character hex string for AES-256-GCM
MFA_ENCRYPTION_KEY=your-64-character-hex-mfa-encryption-key
MFA_ISSUER=ONECOOLIE Ops Console

# HttpOnly Cookie Authentication Configuration (Phase 6.6)
COOKIE_NAME=onecoolie_refresh
# SameSite policy: 'none' for cross-domain production (requires COOKIE_SECURE=true), 'lax' for same-site / dev
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Optional cookie domain (e.g. .onecoolie.in)
COOKIE_DOMAIN=

# Email OTP Authentication (Transactional Email Provider)
# Option 1: Brevo HTTPS API (Preferred in production)
BREVO_API_KEY=your-brevo-api-key
# Option 2: Resend HTTPS API
RESEND_API_KEY=your-resend-api-key
# Option 3: Gmail App Password (Development / Fallback only)
GMAIL_USER=notifications@onecoolie.in
GMAIL_APP_PASSWORD=your-16-character-app-password
OTP_FROM_NAME=OneCoolie
OTP_EXPIRY_MINUTES=10

# Indian Railway RapidAPI (IRCTC Station & Train Schedule Sync)
TRAIN_API_KEY=your-rapidapi-key
TRAIN_API_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
TRAIN_API_BASE_URL=https://irctc-indian-railway-pnr-status.p.rapidapi.com

# Razorpay Payment Gateway (Phase 2 & Phase 6 Live Mode)
# Live keys MUST begin with 'rzp_live_' for production transactions
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-live-razorpay-key-secret
# Secret configured in Razorpay Webhook dashboard for https://api.onecoolie.in/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your-live-webhook-hmac-secret
# Optional Razorpay Merchant Account ID
RAZORPAY_ACCOUNT_ID=acc_xxxxxxxxxxxxxx
