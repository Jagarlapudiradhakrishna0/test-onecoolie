# ==============================================================================
# ONECOOLIE Frontend Environment Template
# Public frontend variables ONLY (prefixed with VITE_).
# Never place database passwords, backend secrets, or private keys in this file!
# ==============================================================================

# Backend API endpoint
VITE_API_URL=https://onecoolie.onrender.com/api

# Real-time WebSocket server endpoint
VITE_SOCKET_URL=https://onecoolie.onrender.com

# Public Razorpay Key ID (Key ID only — NEVER supply Key Secret here!)
# In production, must begin with 'rzp_live_'
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Public Supabase Configuration (Publishable/Anon key only — NEVER Service Role Key!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_anon_key
